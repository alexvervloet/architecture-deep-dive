# Which model stack to use. mock = offline, deterministic, no key (the default,
# and what every measurement in this repo is taken against).
PROVIDER=mock

# No API keys here. Keys live in your OS keychain and are injected per-command
# by `secrun`; see ../docs/SECRETS.md. A real provider without its
# key degrades to the mock loudly. Set PROVIDER_STRICT=1 to make it fail hard.
